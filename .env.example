# Spotlight Marketing Client Portal: environment variables.
#
# Variable NAMES only. Never commit real values. Copy to .env.local for local
# development. Each environment (development, preview, staging, production) has its own
# separate values and credentials; see docs/DEVELOPMENT.md and spec 02 §4.

# ---------------------------------------------------------------------------
# Phase 1 (required)
# ---------------------------------------------------------------------------

# One of: development | test | preview | staging | production
APP_ENV=development

# Public base URL of this deployment (used for metadata and absolute links).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Phase 2 (required): Supabase. LOCAL STACK ONLY outside staging and production
# (spec 03 §15). Copy the values printed by `supabase status`.
# ---------------------------------------------------------------------------

# Local API URL, for example http://127.0.0.1:54321. A hosted URL fails validation
# outside staging and production.
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key (sb_publishable_...). Used only by server code: the browser never
# calls Supabase directly.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret key (sb_secret_...). Server-only; bypasses RLS. Read only by
# src/server/supabase/admin.ts. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# ---------------------------------------------------------------------------
# Later phases: NOT used yet. Listed for planning only.
# Leave unset until the owning phase is authorized.
# ---------------------------------------------------------------------------

# Phase 3: Stripe, TEST MODE ONLY outside production.
# A live-mode key outside production fails startup validation (spec 02 §4).
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# Phase 4: Resend transactional email
# RESEND_API_KEY=
